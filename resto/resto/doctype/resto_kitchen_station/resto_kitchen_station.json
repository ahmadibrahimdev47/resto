   "fieldname": "print_method",
   "fieldtype": "Select",
   "label": "Printing Method",
   "options": "Server Printer\nBrowser Automatic\nBrowser Button\nNo Printing",
   "default": "Browser Button",
   "description": "Server Printer: the server prints on a network printer. Browser Automatic: the kitchen screen whose Auto Printing is on for this station prints each new ticket on its computer printer, with no click. Browser Button: a ticket prints with its Print button. No Printing: tickets show on the screen only. The Print button of a ticket works in every method."
  },
  {
   "fieldname": "printer",
   "fieldtype": "Link",
   "options": "Network Printer Settings",
   "label": "Kitchen Printer",
   "depends_on": "eval:doc.print_method=='Server Printer'",
   "mandatory_depends_on": "eval:doc.print_method=='Server Printer'"
  },
  {
   "fieldname": "auto_print",
   "fieldtype": "Check",
   "label": "Print Tickets Automatically",
   "depends_on": "eval:doc.print_method=='Server Printer'"
  },
  {
   "fieldname": "auto_print_minutes",
   "fieldtype": "Int",
   "label": "Missed Tickets Print Window (Minutes)",
   "default": "30",
   "non_negative": 1,
   "depends_on": "eval:doc.print_method=='Browser Automatic'",
   "description": "A kitchen screen that starts printing later prints the tickets it missed within this time, if they are still to be made. Older ones never print by themselves: every kitchen screen lists them in red, to print with their button."
  },
  {
   "fieldname": "print_format",
   "fieldtype": "Link",
   "options": "Print Format",
   "label": "Ticket Print Format",
   "depends_on": "eval:doc.print_method!='No Printing'",
   "description": "Leave empty to use Resto Kitchen Ticket."
  },
  {
   "fieldname": "copies",
   "fieldtype": "Table",
   "options": "Resto Print Copy",
   "label": "Ticket Copies",
   "depends_on": "eval:doc.print_method!='No Printing'",
   "description": "One row per copy. No rows: one copy. From the browser too: each copy prints as its own page."
